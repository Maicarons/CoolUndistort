{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoolUndistort",
  "version": "1.2.0",
  "identifier": "ai.commandcode.coolundistort",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "title": "CoolUndistort", "width": 1100, "height": 750 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "license": "../../LICENSE"
  }
}
